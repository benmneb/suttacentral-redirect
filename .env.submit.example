# Copy to .env.submit (git-ignored) and fill in, or generate it with:
#   npx publish-browser-extension@6.1.1 init

# Chrome Web Store API v2: https://developer.chrome.com/docs/webstore/service-accounts
# Publisher ID is under Publisher settings: https://chrome.google.com/webstore/devconsole/
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# Firefox Add-ons: https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
